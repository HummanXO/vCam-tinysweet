#!/bin/sh
set -e
if [ "$1" = configure ]; then
    install -d -m 0755 -o mobile -g mobile /var/jb/var/mobile/VCam/Media
    if ! launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.tinysweet.vcam.obs.plist 2>/dev/null; then
        launchctl kickstart -k system/com.tinysweet.vcam.obs 2>/dev/null || true
    fi
fi
exit 0
